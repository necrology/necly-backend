# Copy to .runtime.env only for a disposable validation stack. The up.sh
# script generates stronger random values automatically. Never commit real
# values and never reuse production secrets here.
POSTGRES_USER=necly_validation
POSTGRES_DB=necly_validation
POSTGRES_PASSWORD=replace-with-generated-value
REDIS_PASSWORD=replace-with-generated-value
JWT_SECRET=replace-with-at-least-32-random-bytes
CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-32-bytes
