# Application
APP_ENV=development
APP_PORT=8080
APP_BASE_URL=http://localhost:8080

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=necly
DB_SSL_MODE=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT (generate with: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-32-byte-secret-at-least-in-production
JWT_ISSUER=necly
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
JWT_VERIFICATION_TTL=24h

# Credential Encryption (32 bytes base64)
# Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

# Rate Limiting
RATE_LIMIT_RPM=60
RATE_LIMIT_BURST=10

# Payment Provider (midtrans | xendit | mock)
PAYMENT_PROVIDER=mock
PAYMENT_SANDBOX=true

# Midtrans (if using midtrans)
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# MIDTRANS_MERCHANT_ID=
# MIDTRANS_IS_PRODUCTION=false

# Xendit (if using xendit)
# XENDIT_API_KEY=
# XENDIT_CALLBACK_TOKEN=
# XENDIT_IS_PRODUCTION=false

# Google OAuth (if enabled)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# Email (SMTP)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=necly@neclyservices.com

# MinIO / S3
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=necly
# S3_REGION=us-east-1
# S3_USE_SSL=false