# Application
APP_ENV=development
APP_PORT=8080
# APP_BASE_URL is this API's own origin.
APP_BASE_URL=http://localhost:8080
# FRONTEND_BASE_URL is the storefront origin. Password reset links are built
# from it (e.g. http://localhost:3000/reset-password?token=...). When empty it
# falls back to the first entry of CORS_ALLOWED_ORIGINS.
FRONTEND_BASE_URL=http://localhost:3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=necly
DB_SSL_MODE=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT (generate with: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-32-byte-secret-at-least-in-production
JWT_ISSUER=necly
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
JWT_VERIFICATION_TTL=24h
# How long a "lupa kata sandi" link stays usable.
PASSWORD_RESET_TTL=45m

# Credential Encryption (32 bytes base64)
# Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

# Rate Limiting
RATE_LIMIT_RPM=60
RATE_LIMIT_BURST=10

# Payment Provider (midtrans | xendit | mock)
PAYMENT_PROVIDER=mock
PAYMENT_SANDBOX=true

# Midtrans (if using midtrans)
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# MIDTRANS_MERCHANT_ID=
# MIDTRANS_IS_PRODUCTION=false

# Xendit (if using xendit)
# XENDIT_API_KEY=
# XENDIT_CALLBACK_TOKEN=
# XENDIT_IS_PRODUCTION=false

# Google OAuth (if enabled)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# Email (SMTP)
# Leave SMTP_HOST empty to keep transactional email DISABLED: the server logs a
# loud warning at boot and every message (password reset link, issue report
# notification) is written to the log instead of being delivered.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<address>,
# SMTP_PASSWORD=<16-character App Password>, SMTP_TLS=true
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TLS=true
# EMAIL_FROM=neclyservice@gmail.com
# EMAIL_FROM_NAME=Necly Services

# Issue reports (QA "Laporan Kendala")
# Where the notification for each new report is sent. Empty disables it; the
# report is still stored and visible to admins.
# REPORT_ADMIN_EMAIL=

# MinIO / S3
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=necly
# S3_REGION=us-east-1
# S3_USE_SSL=false